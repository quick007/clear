# Local Docker Compose settings only. Production secrets belong in the host's
# secret manager and must not reuse these values.
COMPOSE_PROJECT_NAME=groundtruth

# Local listeners
GROUNDTRUTH_API_PORT=3000
GROUNDTRUTH_OTLP_GRPC_PORT=4317
GROUNDTRUTH_OTLP_HTTP_PORT=4318
GROUNDTRUTH_COLLECTOR_HEALTH_PORT=13133
GROUNDTRUTH_POSTGRES_PORT=5432
GROUNDTRUTH_CLICKHOUSE_HTTP_PORT=8123
GROUNDTRUTH_CLICKHOUSE_NATIVE_PORT=9000
GROUNDTRUTH_CHECKOUT_API_PORT=4101
GROUNDTRUTH_PAYMENTS_PORT=4102
GROUNDTRUTH_LOAD_GENERATOR_PORT=4103

# Local persistence
GROUNDTRUTH_POSTGRES_PASSWORD=local-postgres-password
GROUNDTRUTH_CLICKHOUSE_PASSWORD=local-clickhouse-password

# Local service authentication
GROUNDTRUTH_COLLECTOR_SECRET=local-collector-service-secret
GROUNDTRUTH_SITE_HANDOFF_SECRET=local-sites-handoff-secret
GROUNDTRUTH_SESSION_SECRET=local-session-secret
GROUNDTRUTH_ADMIN_TOKEN=local-admin-token-change-before-sharing-1234
GROUNDTRUTH_SANDBOX_SESSION_LIMIT=25
GROUNDTRUTH_SANDBOX_CREATIONS_PER_MINUTE=5
GROUNDTRUTH_AUTHENTICATED_REQUESTS_PER_MINUTE=120
GROUNDTRUTH_PUBLIC_REQUESTS_PER_MINUTE=1200
GROUNDTRUTH_DEMO_INGEST_KEY=local-demo-ingest-key
GROUNDTRUTH_PAYMENTS_SERVICE_TOKEN=local-payments-service-token
GROUNDTRUTH_PAYMENTS_CONTROL_TOKEN=local-payments-control-token
GROUNDTRUTH_LOAD_CONTROL_TOKEN=local-load-control-token

# Local browser origins
GROUNDTRUTH_CONSOLE_ORIGIN=http://localhost:5173
GROUNDTRUTH_DEV_CONSOLE_ORIGIN=http://127.0.0.1:5173
GROUNDTRUTH_CHECKOUT_WEB_ORIGIN=http://localhost:5174

# Repeatable example scenario
GROUNDTRUTH_SCENARIO_SEED=groundtruth-retry-storm-v1
GROUNDTRUTH_BASELINE_RPS=50
GROUNDTRUTH_UNIQUE_USERS=800
GROUNDTRUTH_BASELINE_DURATION_MS=20000 # 20 seconds
GROUNDTRUTH_BLIP_DURATION_MS=10000 # 10 seconds
GROUNDTRUTH_MAX_SCENARIO_DURATION_MS=900000 # 15 minutes
GROUNDTRUTH_PAYMENTS_EXPECTED_RPS=51
GROUNDTRUTH_PAYMENTS_OVERLOAD_GAIN=0.22
GROUNDTRUTH_PAYMENTS_OVERLOAD_LATENCY_MS=35 # 35 milliseconds per excess request per second
