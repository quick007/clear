# Browser requests from the console to the Clear API.
VITE_GROUNDTRUTH_API_URL=http://localhost:3000

# Public OTLP/HTTP endpoint shown in the Connect flow.
VITE_CLEAR_OTLP_ENDPOINT=http://localhost:4318

# Public API origin used for browser redirects and shared-domain auth cookies.
GROUNDTRUTH_API_ORIGIN=http://localhost:3000

# Optional server-to-server origin used only to create identity handoffs.
# Leave unset locally. Hosted deployments can use the provider's direct origin.
GROUNDTRUTH_INTERNAL_API_ORIGIN=

# Required only when exercising the hosted identity handoff worker locally.
GROUNDTRUTH_SITE_HANDOFF_SECRET=replace-with-a-long-random-secret
