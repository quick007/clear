{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:clear:schemas:devpost-media-manifest",
  "title": "Clear Devpost media manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sourceDirectory", "outputDirectory", "sources"],
  "anyOf": [{ "required": ["assets"] }, { "required": ["assetFiles"] }],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "sourceDirectory": { "$ref": "#/$defs/relativePath" },
    "outputDirectory": { "$ref": "#/$defs/relativePath" },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/source" }
    },
    "assetFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "positiveInteger": { "type": "integer", "minimum": 1 },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "(^/)|(^|/)\\.\\.(/|$)" }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "viewport", "state"],
      "properties": {
        "route": { "type": "string", "minLength": 1 },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "$ref": "#/$defs/positiveInteger" },
            "height": { "$ref": "#/$defs/positiveInteger" }
          }
        },
        "state": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "description", "capture"],
      "properties": {
        "file": { "$ref": "#/$defs/relativePath" },
        "description": { "type": "string", "minLength": 1 },
        "capture": { "$ref": "#/$defs/capture" }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "background"],
      "properties": {
        "width": { "$ref": "#/$defs/positiveInteger" },
        "height": { "$ref": "#/$defs/positiveInteger" },
        "background": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },
    "format": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "quality"],
          "properties": {
            "type": { "const": "jpeg" },
            "quality": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "compressionLevel"],
          "properties": {
            "type": { "const": "png" },
            "compressionLevel": { "type": "integer", "minimum": 0, "maximum": 9 }
          }
        }
      ]
    },
    "crop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "width", "height"],
      "properties": {
        "left": { "type": "integer", "minimum": 0 },
        "top": { "type": "integer", "minimum": 0 },
        "width": { "$ref": "#/$defs/positiveInteger" },
        "height": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "x", "y", "width", "height", "fit", "position"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "$ref": "#/$defs/positiveInteger" },
        "height": { "$ref": "#/$defs/positiveInteger" },
        "fit": { "enum": ["cover", "contain"] },
        "position": { "enum": ["centre", "north", "south", "east", "west"] },
        "crop": { "$ref": "#/$defs/crop" },
        "style": { "$ref": "#/$defs/style" }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "opacity": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "borderRadius": { "type": "integer", "minimum": 0 },
        "border": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "color", "opacity"],
          "properties": {
            "width": { "$ref": "#/$defs/positiveInteger" },
            "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "opacity": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          }
        },
        "shadow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "blur", "spread", "color", "opacity"],
          "properties": {
            "x": { "type": "integer" },
            "y": { "type": "integer" },
            "blur": { "type": "integer", "minimum": 0 },
            "spread": { "type": "integer", "minimum": 0 },
            "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
            "opacity": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          }
        },
        "modulate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["brightness", "saturation"],
          "properties": {
            "brightness": { "type": "number", "minimum": 0.5, "maximum": 1.5 },
            "saturation": { "type": "number", "minimum": 0, "maximum": 2 }
          }
        }
      }
    },
    "editorialPoint": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 }
      }
    },
    "editorialBrand": {
      "allOf": [
        { "$ref": "#/$defs/editorialPoint" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "label"],
          "properties": {
            "x": { "type": "integer", "minimum": 0 },
            "y": { "type": "integer", "minimum": 0 },
            "label": { "type": "string", "minLength": 1, "maxLength": 24 }
          }
        }
      ]
    },
    "editorialHeadline": {
      "allOf": [
        { "$ref": "#/$defs/editorialPoint" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "lines", "size"],
          "properties": {
            "x": { "type": "integer", "minimum": 0 },
            "y": { "type": "integer", "minimum": 0 },
            "lines": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": { "type": "string", "minLength": 1, "maxLength": 72 }
            },
            "size": { "type": "number", "minimum": 30, "maximum": 88 },
            "subtitle": { "type": "string", "minLength": 1, "maxLength": 140 }
          }
        }
      ]
    },
    "editorialCallout": {
      "allOf": [
        { "$ref": "#/$defs/editorialPoint" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "title", "tone"],
          "properties": {
            "x": { "type": "integer", "minimum": 0 },
            "y": { "type": "integer", "minimum": 0 },
            "width": { "$ref": "#/$defs/positiveInteger" },
            "title": { "type": "string", "minLength": 1, "maxLength": 36 },
            "detail": { "type": "string", "minLength": 1, "maxLength": 48 },
            "tone": {
              "enum": ["neutral", "signal", "healthy", "warning", "danger"]
            },
            "anchor": { "$ref": "#/$defs/editorialPoint" }
          }
        }
      ]
    },
    "editorial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theme"],
      "properties": {
        "theme": { "enum": ["dark", "light"] },
        "brand": { "$ref": "#/$defs/editorialBrand" },
        "headline": { "$ref": "#/$defs/editorialHeadline" },
        "callouts": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "#/$defs/editorialCallout" }
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "output", "canvas", "format", "maxBytes", "layers"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "description": { "type": "string", "minLength": 1 },
        "output": { "$ref": "#/$defs/relativePath" },
        "canvas": { "$ref": "#/$defs/canvas" },
        "format": { "$ref": "#/$defs/format" },
        "maxBytes": { "$ref": "#/$defs/positiveInteger" },
        "editorial": { "$ref": "#/$defs/editorial" },
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/layer" }
        }
      }
    }
  }
}
